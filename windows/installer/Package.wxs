<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="BRIDGE for Windows" Manufacturer="BRIDGE" Version="1.0.0.0" UpgradeCode="B7E91A4E-2D6C-4C3B-9F70-1234567890AB">
    <MajorUpgrade DowngradeErrorMessage="A newer version of BRIDGE is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Feature Id="MainFeature" Title="BRIDGE Desktop" Level="1">
      <ComponentGroupRef Id="BridgePublishedFiles" />
    </Feature>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="BRIDGE" />
    </StandardDirectory>
  </Package>

  <Fragment>
    <ComponentGroup Id="BridgePublishedFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.PublishDir)\**" />
    </ComponentGroup>
  </Fragment>
</Wix>
